# ============================================================
# .env.example — copy to .env and fill in real values.
# .env is git-ignored and must NEVER be committed.
# ============================================================

# ---- SQL Server connection strings -------------------------
# Use SQL auth format for Docker / Azure (Trusted_Connection=False)
ConnectionStrings__JenianAuthConnection=Server=<host>;Database=JenianAuthDb;User Id=<user>;Password=<password>;TrustServerCertificate=True
ConnectionStrings__JenianDbConnection=Server=<host>;Database=JenianDb;User Id=<user>;Password=<password>;TrustServerCertificate=True

# ---- JWT ---------------------------------------------------
jwt__Key=<your-long-random-secret-at-least-32-chars>
jwt__Issuer=https://<your-api-domain>
jwt__Audience=https://<your-frontend-domain>

# ---- Telegram ----------------------------------------------
Telegram__BotToken=<your-telegram-bot-token>

# ---- OpenAI ------------------------------------------------
OpenAI__ApiKey=<your-openai-api-key>
OpenAI__Model=gpt-4o

# ---- Azure Computer Vision ---------------------------------
AzureVision__VisionEndpoint=https://<your-resource>.cognitiveservices.azure.com/
AzureVision__VisionKey=<your-azure-vision-key>

# ---- Ollama (local LLM, optional) --------------------------
Ollama__BaseUrl=http://localhost:11434
Ollama__Model=llava:7b

# ---- Migrations (set to true only for one-off migration runs) --
RUN_MIGRATIONS=false

# ---- ASP.NET Core ------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_HTTP_PORTS=8080
