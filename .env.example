# ============================================================
# .env.example  –  Environment variable template
#
# Copy this file to .env (which is git-ignored) and fill in
# the real values before running docker compose.
#
# The .env file is for LOCAL DOCKER TESTING only.
# In production (Azure), set these as Application Settings /
# secrets in Azure Container Apps or App Service – NEVER
# commit a filled-in .env file to source control.
# ============================================================

# ---- SQL Server (local Docker only) ----
# Strong password required: upper, lower, digit, symbol, ≥8 chars
SQL_SA_PASSWORD=YourStr0ng!LocalPassword

# ---- JWT ----
# Must be at least 32 random characters (longer is better).
# Generate with: openssl rand -base64 48
JWT_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# ---- OpenAI ----
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o

# ---- Azure AI Vision ----
AZURE_VISION_ENDPOINT=https://REPLACE.cognitiveservices.azure.com/
AZURE_VISION_KEY=REPLACE_WITH_YOUR_AZURE_VISION_KEY

# ---- Telegram Bot ----
TELEGRAM_BOT_TOKEN=REPLACE_WITH_YOUR_TELEGRAM_BOT_TOKEN
